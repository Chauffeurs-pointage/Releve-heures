// RENDER
// ═══════════════════════════════════════════════════════
function render() {
  renderGantt();
  renderList();
  applyFilter(currentFilter);
}

function renderGantt() {
  const el = document.getElementById('view-gantt');
  el.innerHTML = '';
  const wrap = document.createElement('div');
  wrap.className = 'gantt-wrap';
  const table = document.createElement('table');
  table.className = 'gantt-table';

  // Head
  const thead = document.createElement('thead');
  const tr = document.createElement('tr');
  const th0 = document.createElement('th');
  th0.className = 'lbl-col';
  th0.textContent = 'G7 ÉVIAN 2026';
  tr.appendChild(th0);
  DAYS.forEach(d => {
    const th = document.createElement('th');
    th.className = `day-col ph-${d.phase}`;
    th.innerHTML = `<strong>${d.dow} ${d.date}</strong><span class="ph-label">${d.label}</span>`;
    tr.appendChild(th);
  });
  thead.appendChild(tr);
  table.appendChild(thead);

  // Body
  const tbody = document.createElement('tbody');
  GANTT_ROWS.forEach(row => {
    const tr = document.createElement('tr');
    tr.dataset.persons = row.persons.join(',');
    tr.classList.add('grow');

    const tdL = document.createElement('td');
    tdL.className = 'lbl-cell';
    tdL.style.cssText = `background:${row.color};border-right:3px solid rgba(0,0,0,.15)`;
    tdL.innerHTML = `<div class="lbl-inner"><div class="lbl-name">${row.label}</div><div class="lbl-members">${row.members}</div></div>`;
    tr.appendChild(tdL);

    DAYS.forEach(d => {
      const td = document.createElement('td');
      const isG7 = d.phase === 'g7';
      td.className = `task-cell ph-${d.phase}`;
      td.style.background = isG7 ? '#0f2540' : row.bg;
      td.dataset.site = row.id;
      td.dataset.day = d.id;

      const items = getSiteTasks(row.id, d.id);
      if (!items.length) { td.classList.add('empty'); }
      else {
        items.forEach(item => {
          const div = document.createElement('div');
          div.className = 'ti';
          if (item.h) {
            const s = document.createElement('span');
            s.className = 'tt';
            s.style.cssText = `background:${row.color}25;color:${isG7?'#FFD080':row.color}`;
            s.textContent = item.h;
            div.appendChild(s);
          } else {
            const b = document.createElement('span');
            b.className = 'tbullet';
            b.style.color = isG7 ? 'var(--gold)' : row.color;
            b.textContent = '▸';
            div.appendChild(b);
          }
          const t = document.createElement('span');
          t.className = 'tx';
          t.style.color = isG7 ? '#C8DCF0' : row.dk;
          t.textContent = item.t;
          div.appendChild(t);
          td.appendChild(div);
        });
      }

      if (editMode) {
        td.classList.add('editable');
        td.addEventListener('click', () => openEdit('site', row.id, d.id));
      }
      tr.appendChild(td);
    });
    tbody.appendChild(tr);
  });
  table.appendChild(tbody);
  wrap.appendChild(table);
  el.appendChild(wrap);
}

function renderList() {
  const el = document.getElementById('view-list');
  el.innerHTML = '<div class="list-grid" id="listGrid"></div>';
  const grid = document.getElementById('listGrid');

  Object.entries(PERSONS).forEach(([pid, p]) => {
    const card = document.createElement('div');
    card.className = 'pcard';
    card.dataset.person = pid;

    card.innerHTML = `<div class="pcard-hd" style="background:${p.bg}">
      <div class="pavatar" style="background:${p.color}">${p.name[0]}</div>
      <div>
        <div class="pcard-name" style="color:${p.dk}">${p.name}</div>
        <div class="pcard-role" style="color:${p.dk}">${p.role}</div>
      </div>
    </div><div class="pdays" id="pdays-${pid}"></div>`;
    grid.appendChild(card);

    renderPersonDays(pid);
  });
}

function renderPersonDays(pid) {
  const el = document.getElementById(`pdays-${pid}`);
  if (!el) return;
  const p = PERSONS[pid];
  el.innerHTML = '';

  DAYS.forEach(d => {
    const items = getTasks(pid, d.id);
    const has = items.length > 0;

    const row = document.createElement('div');
    row.className = `pday-row ph-${d.phase}${editMode ? ' editable' : ''}`;
    row.dataset.person = pid;
    row.dataset.day = d.id;
    row.style.opacity = has ? '' : '0.3';

    const badge = `<div class="dbadge">
      <div class="dbadge-date">${d.date}</div>
      <div class="dbadge-dow">${d.dow}</div>
    </div>`;

    const tasksEl = document.createElement('div');
    tasksEl.className = 'pday-tasks';
    if (has) {
      tasksEl.innerHTML = items.map(item => `
        <div class="pday-ti">
          ${item.h ? `<span class="pday-th" style="color:${p.color}">${item.h}</span>` : `<span style="color:${p.color};font-size:11px;flex-shrink:0">▸</span>`}
          <span>${item.t}</span>
        </div>`).join('');
    } else {
      tasksEl.innerHTML = '<span class="notask">Aucune tâche</span>';
    }

    row.innerHTML = badge;
    row.appendChild(tasksEl);

    if (editMode) {
      tasksEl.style.cursor = 'pointer';
      tasksEl.addEventListener('click', () => openEdit('person', pid, d.id));
    }
    el.appendChild(row);
  });
}

// ═══════════════════════════════════════════════════════
// FILTER
// ═══════════════════════════════════════════════════════
function filter(pid) {
  currentFilter = pid;
  document.querySelectorAll('.pf-btn').forEach(b => {
    const isActive = b.dataset.p === pid;
    b.classList.toggle('active', isActive);
    if (isActive && pid !== 'all') {
      b.style.background = `var(--c-${pid})`;
      b.style.borderColor = `var(--c-${pid})`;
    } else if (!isActive) {
      b.style.background = '';
      b.style.borderColor = '';
    }
  });
  applyFilter(pid);
}

function applyFilter(pid) {
  document.querySelectorAll('.grow').forEach(row => {
    const persons = row.dataset.persons?.split(',') || [];
    row.classList.toggle('dimmed', pid !== 'all' && !persons.includes(pid));
  });
  document.querySelectorAll('.pcard').forEach(card => {
    const match = pid === 'all' || card.dataset.person === pid;
    card.style.display = match ? '' : 'none';
  });
}

