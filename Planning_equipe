// ═══════════════════════════════════════════════════════
// GOOGLE SHEETS INTEGRATION
// ═══════════════════════════════════════════════════════
async function loadFromSheet() {
  if (SHEET_ID === 'VOTRE_SHEET_ID_ICI') {
    allTasks = JSON.parse(JSON.stringify(DEFAULT_TASKS));
    setSyncBadge('local', '● local uniquement');
    render();
    return;
  }

  setSyncBadge('loading', '⟳ chargement...');
  setLoading(true);

  try {
    const url = `https://docs.google.com/spreadsheets/d/${SHEET_ID}/gviz/tq?tqx=out:json&sheet=${encodeURIComponent(SHEET_NAME)}`;
    const res = await fetch(url);
    const text = await res.text();
    // Google wraps in google.visualization.Query.setResponse(...)
    const json = JSON.parse(text.match(/google\.visualization\.Query\.setResponse\(([\s\S]*)\)/)[1]);
    const rows = json.table.rows;

    // Reset to defaults then apply sheet overrides
    allTasks = JSON.parse(JSON.stringify(DEFAULT_TASKS));

    rows.forEach(row => {
      const cells = row.c;
      if (!cells || !cells[0]) return;
      const target = (cells[0]?.v || '').toString().trim().toLowerCase(); // site or person id
      const dateStr = (cells[1]?.v || '').toString().trim();              // ex: "9 juin"
      const heure   = (cells[2]?.v || '').toString().trim();
      const texte   = (cells[3]?.v || '').toString().trim();
      if (!target || !dateStr || !texte) return;

      const day = DAYS.find(d => d.date === dateStr);
      if (!day) return;

      const key = `${target}__${day.id}`;
      if (!allTasks[key]) allTasks[key] = [];
      // Check if task already exists to avoid duplicates
      if (!allTasks[key].find(t => t.t === texte)) {
        allTasks[key].push({h: heure, t: texte});
      }
    });

    sheetConnected = true;
    setSyncBadge('ok', '● synchro Google Sheets');
  } catch(e) {
    console.warn('Sheet load error:', e);
    allTasks = JSON.parse(JSON.stringify(DEFAULT_TASKS));
    setSyncBadge('err', '⚠ hors ligne — données locales');
  }

  setLoading(false);
  render();
}

async function pushToSheet(target, dateStr, items) {
  // APPS_SCRIPT_URL : à remplir après déploiement du script Google
  const APPS_SCRIPT_URL = window.APPS_SCRIPT_URL || '';

  if (!APPS_SCRIPT_URL) {
    showToast('⚠ Apps Script non configuré — voir instructions');
    return;
  }

  setSyncBadge('loading', '⟳ sauvegarde...');
  try {
    // no-cors : on ne peut pas lire la réponse mais l'écriture fonctionne
    await fetch(APPS_SCRIPT_URL, {
      method: 'POST',
      mode:   'no-cors',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({
        action:    'upsert',
        target:    target,
        date:      dateStr,
        items:     items,
        sheetName: SHEET_NAME
      })
    });
    setSyncBadge('ok', '● synchro Google Sheets');
    showToast('✓ Sauvegardé dans Google Sheets');
  } catch(e) {
    setSyncBadge('err', '⚠ erreur de sauvegarde');
    showToast('⚠ Erreur réseau — réessayez');
    console.error(e);
  }
}

// ═══════════════════════════════════════════════════════
// TASK RESOLUTION
// ═══════════════════════════════════════════════════════
function getTasks(id, dayId) {
  // Person-specific override takes priority over site
  const personKey = `${id}__${dayId}`;
  if (allTasks[personKey]) return allTasks[personKey];

  // Find which site this person belongs to
  for (const [site, persons] of Object.entries(SITE_PERSONS)) {
    if (persons.includes(id)) {
      const siteKey = `${site}__${dayId}`;
      if (allTasks[siteKey]) return allTasks[siteKey];
    }
  }
  return [];
}

function getSiteTasks(siteId, dayId) {
  return allTasks[`${siteId}__${dayId}`] || [];
}

