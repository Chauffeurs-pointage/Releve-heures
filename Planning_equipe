function closePinModal() { document.getElementById('pinOverlay').classList.remove('open'); }
function onPinInput() {
  document.getElementById('pinError').textContent = '';
  if (document.getElementById('pinInput').value.length === 4) checkPin();
}
function checkPin() {
  const val = document.getElementById('pinInput').value;
  if (val === PIN) {
    closePinModal();
    toggleEditMode(true);
  } else {
    document.getElementById('pinError').textContent = 'Code incorrect';
    document.getElementById('pinInput').value = '';
    document.getElementById('pinInput').focus();
  }
}
function toggleEditMode(on) {
  editMode = on;
  const btn = document.getElementById('editBtn');
  const ind = document.getElementById('editIndicator');
  btn.textContent = on ? '✎ Quitter édition' : '✎ Éditer';
  btn.classList.toggle('on', on);
  ind.classList.toggle('visible', on);
  render();
}

// ═══════════════════════════════════════════════════════
// EDIT MODAL
// ═══════════════════════════════════════════════════════
function openEdit(type, id, dayId) {
  editCtx = {type, id, dayId};
  editScope = type === 'site' ? 'site' : 'person';

  const day = DAYS[dayId];
  const isSite = type === 'site';

  if (isSite) {
    const row = GANTT_ROWS.find(r => r.id === id);
    document.getElementById('emTitle').textContent = `${row.label} — ${day.date}`;
    document.getElementById('emSub').textContent = `${day.label}  ·  ${row.members}`;
    editItems = JSON.parse(JSON.stringify(getSiteTasks(id, dayId)));
    document.getElementById('emScope').style.display = 'none';
  } else {
    const p = PERSONS[id];
    document.getElementById('emTitle').textContent = `${p.name} — ${day.date}`;
    document.getElementById('emSub').textContent = `${day.label}  ·  ${p.role}`;
    editItems = JSON.parse(JSON.stringify(getTasks(id, dayId)));
    // Show scope selector if person belongs to a site
    const hasSite = Object.entries(SITE_PERSONS).some(([s,ps]) => ps.includes(id));
    document.getElementById('emScope').style.display = hasSite ? 'flex' : 'none';
    setScope('person');
  }

  renderEditRows();
  document.getElementById('editOverlay').classList.add('open');
}

function setScope(s) {
  editScope = s;
  document.getElementById('scopeSite').classList.toggle('active', s === 'site');
  document.getElementById('scopePerson').classList.toggle('active', s === 'person');
}

function renderEditRows() {
  const list = document.getElementById('taskRows');
  list.innerHTML = '';
  editItems.forEach((item, i) => {
    const row = document.createElement('div');
    row.className = 'task-row';
    row.innerHTML = `
      <input class="inp-time" type="text" placeholder="heure" value="${item.h||''}"
             oninput="editItems[${i}].h=this.value">
      <input class="inp-text" type="text" placeholder="Description de la tâche..." value="${item.t||''}"
             oninput="editItems[${i}].t=this.value">
      <button class="del-btn" onclick="delRow(${i})">×</button>`;
    list.appendChild(row);
  });
}

function addRow() {
  editItems.push({h:'',t:''});
  renderEditRows();
  const inputs = document.querySelectorAll('.inp-text');
  inputs[inputs.length-1]?.focus();
}

function delRow(i) {
  editItems.splice(i,1);
  renderEditRows();
}

function closeEdit() {
  document.getElementById('editOverlay').classList.remove('open');
  editCtx = null; editItems = [];
}

function saveEdit() {
  const cleaned = editItems.filter(it => it.t.trim());
  const {type, id, dayId} = editCtx;
  const day = DAYS[dayId];

  if (type === 'site') {
    // Apply to site key
    allTasks[`${id}__${dayId}`] = cleaned;
    // Propagate to persons of this site (unless they have a personal override)
    const persons = SITE_PERSONS[id] || [];
    persons.forEach(pid => {
      // Only propagate if no personal override exists
      if (!allTasks[`${pid}__${dayId}`]) {
        // Refresh will pull from site key automatically
      }
    });
    pushToSheet(id, day.date, cleaned);
  } else {
    if (editScope === 'site') {
      // Find site for this person and save as site
      const siteEntry = Object.entries(SITE_PERSONS).find(([s,ps]) => ps.includes(id));
      if (siteEntry) {
        const siteId = siteEntry[0];
        allTasks[`${siteId}__${dayId}`] = cleaned;
        // Clear person override if any
        delete allTasks[`${id}__${dayId}`];
        pushToSheet(siteId, day.date, cleaned);
      }
    } else {
      // Personal override
      allTasks[`${id}__${dayId}`] = cleaned;
      pushToSheet(id, day.date, cleaned);
    }
  }

  closeEdit();
  render();
  // Reload from sheet after short delay to confirm sync
  if (window.APPS_SCRIPT_URL) {
    setTimeout(() => loadFromSheet(), 2200);
  }
}

// ═══════════════════════════════════════════════════════
// VIEW SWITCH
// ═══════════════════════════════════════════════════════
function setView(v) {
  currentView = v;
  document.getElementById('view-gantt').style.display = v==='gantt'?'block':'none';
  document.getElementById('view-list').style.display  = v==='list'?'block':'none';
  document.querySelectorAll('.view-btn').forEach(b =>
    b.classList.toggle('active', (v==='gantt'&&b.textContent==='Gantt')||(v==='list'&&b.textContent==='Par personne')));
}

// ═══════════════════════════════════════════════════════
// UI HELPERS
// ═══════════════════════════════════════════════════════
function setSyncBadge(state, text) {
  const b = document.getElementById('syncBadge');
  b.className = `sync-badge ${state}`;
  b.textContent = text;
}
function setLoading(on) {
  const b = document.getElementById('loadingBar');
  b.classList.toggle('active', on);
}
function showToast(msg) {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  setTimeout(() => t.classList.remove('show'), 2800);
}

// Keyboard shortcuts
document.addEventListener('keydown', e => {
  if (e.key === 'Escape') { closeEdit(); closePinModal(); }
});
document.getElementById('editOverlay').addEventListener('click', e => {
  if (e.target === document.getElementById('editOverlay')) closeEdit();
});
document.getElementById('pinOverlay').addEventListener('click', e => {
  if (e.target === document.getElementById('pinOverlay')) closePinModal();
});

// ── Init ──
// Inject Apps Script URL from config constant
window.APPS_SCRIPT_URL = APPS_SCRIPT_URL_CONFIG;
loadFromSheet();
</script>
</body>
</html>
